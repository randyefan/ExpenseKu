        "id": { "stringUnit": { "state": "translated", "value": "Gaji" } }
      }
    },
    "guideStart1Row2Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Add income line · expected money, not an Expense" } },
        "id": { "stringUnit": { "state": "translated", "value": "Tambah pemasukan · uang yang diharapkan, bukan pengeluaran" } }
      }
    },
    "guideStart1Row3Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Add plan item" } },
        "id": { "stringUnit": { "state": "translated", "value": "Tambah item rencana" } }
      }
    },
    "guideStart1Row3Value": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Allocation" } },
        "id": { "stringUnit": { "state": "translated", "value": "Alokasi" } }
      }
    },
    "guideStart1Row3Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose Fixed, Envelope or Set aside." } },
        "id": { "stringUnit": { "state": "translated", "value": "Pilih Pembayaran, Pos anggaran atau Sisihkan." } }
      }
    },
    "guideStart1Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use the right +" } },
        "id": { "stringUnit": { "state": "translated", "value": "Gunakan + yang tepat" } }
      }
    },
    "guideStart1Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Add plan item and Add income line are at the foot of Plan. The toolbar + still logs a real Expense." } },
        "id": { "stringUnit": { "state": "translated", "value": "Tambah item rencana dan Tambah pemasukan ada di bagian bawah Rencana. Tombol + di toolbar tetap mencatat pengeluaran nyata." } }
      }
    },
    "guideStart2Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Reuse and fill gaps" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pakai ulang dan isi celah" } }
      }
    },
    "guideStart2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Reuse what still makes sense" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pakai ulang yang masih relevan" } }
      }
    },
    "guideStart2Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Copy an earlier plan on purpose, then adjust it for this cycle." } },
        "id": { "stringUnit": { "state": "translated", "value": "Salin rencana sebelumnya dengan sengaja, lalu sesuaikan untuk periode ini." } }
      }
    },
    "guideStart2Card": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A fresh November" } },
        "id": { "stringUnit": { "state": "translated", "value": "November yang baru" } }
      }
    },
    "guideStart2Row1Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Copy from October" } },
        "id": { "stringUnit": { "state": "translated", "value": "Salin dari Oktober" } }
      }
    },
    "guideStart2Row1Value": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Reuse" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pakai ulang" } }
      }
    },
    "guideStart2Row1Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keep planned amounts. Arrived, Funded and Done start fresh. Set aside lines are not copied." } },
        "id": { "stringUnit": { "state": "translated", "value": "Nominal terencana tetap. Status masuk, Dana siap dan Sudah dibayar dimulai ulang. Baris Sisihkan tidak disalin." } }
      }
    },
    "guideStart2Row2Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Start empty" } },
        "id": { "stringUnit": { "state": "translated", "value": "Mulai dari kosong" } }
      }
    },
    "guideStart2Row2Value": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Fresh" } },
        "id": { "stringUnit": { "state": "translated", "value": "Baru" } }
      }
    },
    "guideStart2Row2Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Create a blank plan instead; paging never copies automatically." } },
        "id": { "stringUnit": { "state": "translated", "value": "Buat rencana kosong; berpindah periode tidak pernah menyalin otomatis." } }
      }
    },
    "guideStart2Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "From last cycle" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dari periode lalu" } }
      }
    },
    "guideStart2Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Unused zero-amount copied rows stay folded away. Open one and edit its amount to use it again." } },
        "id": { "stringUnit": { "state": "translated", "value": "Baris salinan bernominal nol yang tidak dipakai tetap terlipat. Buka salah satunya dan ubah nominalnya untuk memakainya lagi." } }
      }
    },
    "guideStart2Takeaway2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Look back at October" } },
        "id": { "stringUnit": { "state": "translated", "value": "Lihat kembali Oktober" } }
      }
    },
    "guideStart2Takeaway2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Bring in missing earlier items or Outside plan categories. It skips Set aside and leaves the earlier plan alone." } },
        "id": { "stringUnit": { "state": "translated", "value": "Tambahkan item lama yang belum ada atau kategori Di luar rencana. Sisihkan dilewati dan rencana sebelumnya tidak diubah." } }
      }
    },
    "guideTypesTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Allocation types" } },
        "id": { "stringUnit": { "state": "translated", "value": "Jenis alokasi" } }
      }
    },
    "guideTypesSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Fixed, Envelope and Set aside" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pembayaran, Pos anggaran dan Sisihkan" } }
      }
    },
    "guideTypes1Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Plan and its items" } },
        "id": { "stringUnit": { "state": "translated", "value": "Rencana dan itemnya" } }
      }
    },
    "guideTypes1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "One plan, three kinds of item" } },
        "id": { "stringUnit": { "state": "translated", "value": "Satu rencana, tiga jenis item" } }
      }
    },
    "guideTypes1Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Plan is the whole cycle. These are the allocations you put inside it." } },
        "id": { "stringUnit": { "state": "translated", "value": "Rencana mencakup seluruh periode. Ini alokasi yang kamu masukkan ke dalamnya." } }
      }
    },
    "guideTypes1Card": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Inside November" } },
        "id": { "stringUnit": { "state": "translated", "value": "Di dalam November" } }
      }
    },
    "guideTypes1Row1Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Fixed · Kos" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pembayaran · Kos" } }
      }
    },
    "guideTypes1Row1Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "One payment. Confirm Done to create its real Expense." } },
        "id": { "stringUnit": { "state": "translated", "value": "Satu tagihan. Konfirmasi Sudah dibayar untuk membuat pengeluaran nyatanya." } }
      }
    },
    "guideTypes1Row2Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Envelope · Harian" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pos anggaran · Harian" } }
      }
    },
    "guideTypes1Row2Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "An allowance for many purchases. Counts logged Expenses; never creates one." } },
        "id": { "stringUnit": { "state": "translated", "value": "Jatah untuk banyak pembelian. Menghitung pengeluaran yang dicatat; tidak pernah membuatnya." } }
      }
    },
    "guideTypes1Row3Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Set aside · Liburan" } },
        "id": { "stringUnit": { "state": "translated", "value": "Sisihkan · Liburan" } }
      }
    },
    "guideTypes1Row3Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Planned money toward December's Envelope, before anything is bought." } },
        "id": { "stringUnit": { "state": "translated", "value": "Dana terencana untuk pos anggaran Desember, sebelum ada yang dibeli." } }
      }
    },
    "guideTypes1Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Planned is not spent" } },
        "id": { "stringUnit": { "state": "translated", "value": "Direncanakan bukan berarti terpakai" } }
      }
    },
    "guideTypes1Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Categories can route purchases into an Envelope, or you can assign them explicitly. Expenses linked to Fixed items are excluded." } },
        "id": { "stringUnit": { "state": "translated", "value": "Kategori bisa mengarahkan pembelian ke pos anggaran, atau kamu bisa menetapkannya langsung. Pengeluaran yang tertaut ke Pembayaran tidak dihitung." } }
      }
    },
    "guideTypes2Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Set aside" } },
        "id": { "stringUnit": { "state": "translated", "value": "Sisihkan" } }
      }
    },
    "guideTypes2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Prepare a later envelope" } },
        "id": { "stringUnit": { "state": "translated", "value": "Siapkan pos anggaran berikutnya" } }
      }
    },
    "guideTypes2Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use Set aside when you have not bought anything yet." } },
        "id": { "stringUnit": { "state": "translated", "value": "Gunakan Sisihkan saat kamu belum membeli apa pun." } }
      }
    },
    "guideTypes2Card": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Liburan · December" } },
        "id": { "stringUnit": { "state": "translated", "value": "Liburan · Desember" } }
      }
    },
    "guideTypes2Row1Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "November sets aside" } },
        "id": { "stringUnit": { "state": "translated", "value": "November menyisihkan" } }
      }
    },
    "guideTypes2Row1Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Included in November's 5m planned cost; November has 3m remaining." } },
        "id": { "stringUnit": { "state": "translated", "value": "Termasuk dalam biaya terencana November 5 jt; Sisa November 3 jt." } }
      }
    },
    "guideTypes2Row2Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "December allowance" } },
        "id": { "stringUnit": { "state": "translated", "value": "Jatah Desember" } }
      }
    },
    "guideTypes2Row2Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "1m already set aside; December still contributes 1m." } },
        "id": { "stringUnit": { "state": "translated", "value": "1 jt sudah disisihkan; Desember masih menyumbang 1 jt." } }
      }
    },
    "guideTypes2Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Create the later target first" } },
        "id": { "stringUnit": { "state": "translated", "value": "Buat tujuan berikutnya dulu" } }
      }
    },
    "guideTypes2Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "In Add plan item → Set aside, choose an Envelope in an existing later plan. Add that plan and Envelope first if none is offered." } },
        "id": { "stringUnit": { "state": "translated", "value": "Di Tambah item rencana → Sisihkan, pilih pos anggaran di rencana berikutnya yang sudah ada. Buat rencana dan pos anggaran itu dulu jika belum ada pilihan." } }
      }
    },
    "guideTypes2Takeaway2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Moved is a separate fact" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dipindahkan adalah fakta terpisah" } }
      }
    },
    "guideTypes2Takeaway2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Its tick reports that money moved, creates no Expense and has no Funded stage. The planned credit applies before ticking, is uncapped and is never copied forward." } },
        "id": { "stringUnit": { "state": "translated", "value": "Centangnya melaporkan bahwa uang sudah dipindahkan, tidak membuat pengeluaran, dan tidak punya tahap Dana siap. Kredit terencana berlaku sebelum dicentang, tanpa batas, dan tidak pernah disalin ke periode berikutnya." } }
      }
    },
    "guideManageTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Manage plan items" } },
        "id": { "stringUnit": { "state": "translated", "value": "Kelola item rencana" } }
      }
    },
    "guideManageSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Row actions, Funded, Done and Auto" } },
        "id": { "stringUnit": { "state": "translated", "value": "Aksi baris, Dana siap, Sudah dibayar dan Otomatis" } }
      }
    },
    "guideManage1Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Body and status" } },
        "id": { "stringUnit": { "state": "translated", "value": "Isi baris dan status" } }
      }
    },
    "guideManage1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open a row or update its status" } },
        "id": { "stringUnit": { "state": "translated", "value": "Buka baris atau perbarui statusnya" } }
      }
    },
    "guideManage1Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The row body and its leading status control do different jobs." } },
        "id": { "stringUnit": { "state": "translated", "value": "Isi baris dan kontrol status di depannya punya tugas berbeda." } }
      }
    },
    "guideManage1Card": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Kos · Mandiri" } },
        "id": { "stringUnit": { "state": "translated", "value": "Kos · Mandiri" } }
      }
    },
    "guideManage1Row1Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Tap the row body" } },
        "id": { "stringUnit": { "state": "translated", "value": "Ketuk isi baris" } }
      }
    },
    "guideManage1Row1Value": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Edit" } },
        "id": { "stringUnit": { "state": "translated", "value": "Ubah" } }
      }
    },
    "guideManage1Row1Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Change Fixed or Set aside. An Envelope opens its spending detail." } },
        "id": { "stringUnit": { "state": "translated", "value": "Ubah Pembayaran atau Sisihkan. Pos anggaran membuka rincian pengeluarannya." } }
      }
    },
    "guideManage1Row2Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Todo → Funded" } },
        "id": { "stringUnit": { "state": "translated", "value": "Belum dibayar → Dana siap" } }
      }
    },
    "guideManage1Row2Value": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Moved" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dipindahkan" } }
      }
    },
    "guideManage1Row2Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Moved to Mandiri means money is ready there, not paid." } },
        "id": { "stringUnit": { "state": "translated", "value": "Dipindahkan ke Mandiri berarti dana siap di sana, belum dibayar." } }
      }
    },
    "guideManage1Row3Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Funded → Done" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dana siap → Sudah dibayar" } }
      }
    },
    "guideManage1Row3Value": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Paid…" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dibayar…" } }
      }
    },
    "guideManage1Row3Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Confirm actual amount and date to create the linked Expense. You can pay directly from Todo." } },
        "id": { "stringUnit": { "state": "translated", "value": "Konfirmasi nominal dan tanggal sebenarnya untuk membuat pengeluaran tertaut. Kamu bisa langsung bayar dari Belum dibayar." } }
      }
    },
    "guideManage1Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Each kind behaves differently" } },
        "id": { "stringUnit": { "state": "translated", "value": "Tiap jenis berperilaku berbeda" } }
      }
    },
    "guideManage1Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No Account means no Funded stage. Envelope stops at Funded; Set aside only records moved or not moved." } },
        "id": { "stringUnit": { "state": "translated", "value": "Tanpa sumber dana tidak ada tahap Dana siap. Pos anggaran berhenti di Dana siap; Sisihkan hanya mencatat sudah atau belum dipindahkan." } }
      }
    },
    "guideManage2Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Dates, Auto and undo" } },
        "id": { "stringUnit": { "state": "translated", "value": "Tanggal, Otomatis dan batal" } }
      }
    },
    "guideManage2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Automate carefully, undo deliberately" } },
        "id": { "stringUnit": { "state": "translated", "value": "Otomatiskan dengan hati-hati, batalkan dengan sengaja" } }
      }
    },
    "guideManage2Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Auto and undo can create or delete an Expense, so their effects matter." } },
        "id": { "stringUnit": { "state": "translated", "value": "Otomatis dan pembatalan bisa membuat atau menghapus pengeluaran, jadi efeknya penting." } }
      }
    },
    "guideManage2Card": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Kos as an Auto example" } },
        "id": { "stringUnit": { "state": "translated", "value": "Kos sebagai contoh Otomatis" } }
      }
    },
    "guideManage2Row1Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Due day 5 · Auto" } },
        "id": { "stringUnit": { "state": "translated", "value": "Jatuh tempo 5 · Otomatis" } }
      }
    },
    "guideManage2Row1Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "An alternative setting for the same Kos item, not a second payment." } },
        "id": { "stringUnit": { "state": "translated", "value": "Pengaturan alternatif untuk item Kos yang sama, bukan pembayaran kedua." } }
      }
    },
    "guideManage2Row2Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open after the due day" } },
        "id": { "stringUnit": { "state": "translated", "value": "Buka setelah jatuh tempo" } }
      }
    },
    "guideManage2Row2Value": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review" } },
        "id": { "stringUnit": { "state": "translated", "value": "Periksa" } }
      }
    },
    "guideManage2Row2Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The app posts at the planned amount on opening, not in the background, even without Funded." } },
        "id": { "stringUnit": { "state": "translated", "value": "Aplikasi mencatat nominal terencana saat dibuka, bukan di latar belakang, meski tanpa Dana siap." } }
      }
    },
    "guideManage2Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Check Auto amounts" } },
        "id": { "stringUnit": { "state": "translated", "value": "Periksa nominal Otomatis" } }
      }
    },
    "guideManage2Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Auto requires a due day. Use the review notice to correct what really happened." } },
        "id": { "stringUnit": { "state": "translated", "value": "Otomatis memerlukan tanggal jatuh tempo. Gunakan pemberitahuan periksa untuk mengoreksi yang sebenarnya terjadi." } }
      }
    },
    "guideManage2Takeaway2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Undo Done versus Not moved yet" } },
        "id": { "stringUnit": { "state": "translated", "value": "Batalkan Sudah dibayar versus Belum dipindahkan" } }
      }
    },
    "guideManage2Takeaway2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Undo Done confirms deleting its Expense, returning to Funded with an Account or Todo without one. Not moved yet only clears Funded. Deleting an item keeps an existing Expense." } },
        "id": { "stringUnit": { "state": "translated", "value": "Membatalkan Sudah dibayar meminta konfirmasi untuk menghapus pengeluarannya, lalu kembali ke Dana siap jika ada sumber dana atau Belum dibayar jika tidak. Belum dipindahkan hanya menghapus Dana siap. Menghapus item tetap menyimpan pengeluaran yang ada." } }
      }
    },
    "guideTransfersTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Payday transfers" } },
        "id": { "stringUnit": { "state": "translated", "value": "Transfer gajian" } }
      }
    },
    "guideTransfersSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Destinations and partial moves" } },
        "id": { "stringUnit": { "state": "translated", "value": "Tujuan dan pemindahan sebagian" } }
      }
    },
    "guideTransfers1Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Destination Accounts" } },
        "id": { "stringUnit": { "state": "translated", "value": "Sumber dana tujuan" } }
      }
    },
    "guideTransfers1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "See every destination on payday" } },
        "id": { "stringUnit": { "state": "translated", "value": "Lihat setiap tujuan saat gajian" } }
      }
    },
    "guideTransfers1Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Mark Gaji arrived, then work down the transfer checklist at the foot of Plan." } },
        "id": { "stringUnit": { "state": "translated", "value": "Tandai Gaji sudah masuk, lalu kerjakan daftar transfer di bagian bawah Rencana." } }
      }
    },
    "guideTransfers1Card": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Transfer checklist · 0 of 2 sent" } },
        "id": { "stringUnit": { "state": "translated", "value": "Daftar transfer · 0 dari 2 terkirim" } }
      }
    },
    "guideTransfers1Row1Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Jago" } },
        "id": { "stringUnit": { "state": "translated", "value": "Jago" } }
      }
    },
    "guideTransfers1Row1Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Harian 1.8m + Liburan 1m" } },
        "id": { "stringUnit": { "state": "translated", "value": "Harian 1,8 jt + Liburan 1 jt" } }
      }
    },
    "guideTransfers1Row2Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Mandiri" } },
        "id": { "stringUnit": { "state": "translated", "value": "Mandiri" } }
      }
    },
    "guideTransfers1Row2Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Kos · due 5" } },
        "id": { "stringUnit": { "state": "translated", "value": "Kos · jatuh tempo 5" } }
      }
    },
    "guideTransfers1Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Account is the destination" } },
        "id": { "stringUnit": { "state": "translated", "value": "Sumber dana adalah tujuannya" } }
      }
    },
    "guideTransfers1Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Assign Accounts to items to group what each needs. Items without an Account have no destination line." } },
        "id": { "stringUnit": { "state": "translated", "value": "Tetapkan sumber dana pada item untuk mengelompokkan kebutuhan masing-masing. Item tanpa sumber dana tidak punya baris tujuan." } }
      }
    },
    "guideTransfers1Takeaway2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A checklist, not a bank balance" } },
        "id": { "stringUnit": { "state": "translated", "value": "Daftar periksa, bukan saldo bank" } }
      }
    },
    "guideTransfers1Takeaway2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "These are allocations to prepare, not the Account Gaji came from. Transfer in your bank app, then record it here." } },
        "id": { "stringUnit": { "state": "translated", "value": "Ini alokasi yang perlu disiapkan, bukan sumber dana asal Gaji. Transfer di aplikasi bankmu, lalu catat di sini." } }
      }
    },
    "guideTransfers2Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Partial transfers" } },
        "id": { "stringUnit": { "state": "translated", "value": "Transfer sebagian" } }
      }
    },
    "guideTransfers2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Move just what is ready now" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pindahkan yang siap sekarang saja" } }
      }
    },
    "guideTransfers2Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open Jago and choose which items you have actually moved." } },
        "id": { "stringUnit": { "state": "translated", "value": "Buka Jago dan pilih item yang benar-benar sudah kamu pindahkan." } }
      }
    },
    "guideTransfers2Card": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Transfer to Jago" } },
        "id": { "stringUnit": { "state": "translated", "value": "Transfer ke Jago" } }
      }
    },
    "guideTransfers2Label": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Example · 1 of 2 selected" } },
        "id": { "stringUnit": { "state": "translated", "value": "Contoh · 1 dari 2 dipilih" } }
      }
    },
    "guideTransfers2Row1Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Harian" } },
        "id": { "stringUnit": { "state": "translated", "value": "Harian" } }
      }
    },
    "guideTransfers2Row2Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Liburan · Dec" } },
        "id": { "stringUnit": { "state": "translated", "value": "Liburan · Des" } }
      }
    },
    "guideTransfers2Summary": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Transfer now" } },
        "id": { "stringUnit": { "state": "translated", "value": "Transfer sekarang" } }
      }
    },
    "guideTransfers2Action": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Moved to Jago" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dipindahkan ke Jago" } }
      }
    },
    "guideTransfers2Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "All Todo items start selected" } },
        "id": { "stringUnit": { "state": "translated", "value": "Semua item Belum dibayar langsung terpilih" } }
      }
    },
    "guideTransfers2Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Deselect to move only some. Recording this example makes Harian Funded; 1m for Liburan stays to go. Set aside uses its moved tick, not Funded." } },
        "id": { "stringUnit": { "state": "translated", "value": "Batalkan pilihan untuk memindahkan sebagian. Mencatat contoh ini membuat Harian Dana siap; 1 jt untuk Liburan masih tersisa. Sisihkan memakai centang dipindahkan, bukan Dana siap." } }
      }
    },
    "guideTransfers2Takeaway2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Adjust and revisit" } },
        "id": { "stringUnit": { "state": "translated", "value": "Sesuaikan dan kembali lagi" } }
      }
    },
    "guideTransfers2Takeaway2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Adjustment is taken in the first round only; a negative value reduces Transfer now. Already in lists Funded/Done items. Undo a Funded item there to return it to To send." } },
        "id": { "stringUnit": { "state": "translated", "value": "Penyesuaian hanya dihitung di putaran pertama; nilai negatif mengurangi Transfer sekarang. Sudah di menampilkan item Dana siap/Sudah dibayar. Batalkan item Dana siap di sana untuk mengembalikannya ke Perlu dikirim." } }
      }
    },
    "guideEnvelopeTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Follow an Envelope" } },
        "id": { "stringUnit": { "state": "translated", "value": "Ikuti Pos anggaran" } }
      }
    },
    "guideEnvelopeSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Spending, other Accounts and cycles" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pengeluaran, sumber dana dan periode lain" } }
      }
    },
    "guideEnvelope1Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Counted spending" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pengeluaran terhitung" } }
      }
    },
    "guideEnvelope1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "See what your allowance covers" } },
        "id": { "stringUnit": { "state": "translated", "value": "Lihat apa saja yang dicakup jatahmu" } }
      }
    },
    "guideEnvelope1Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Open Harian to inspect its counted Expenses and remaining allowance." } },
        "id": { "stringUnit": { "state": "translated", "value": "Buka Harian untuk melihat pengeluaran yang dihitung dan sisa jatahnya." } }
      }
    },
    "guideEnvelope1Card": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Harian · Jago" } },
        "id": { "stringUnit": { "state": "translated", "value": "Harian · Jago" } }
      }
    },
    "guideEnvelope1Row1Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Planned allowance" } },
        "id": { "stringUnit": { "state": "translated", "value": "Jatah terencana" } }
      }
    },
    "guideEnvelope1Row1Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Makan + Transport, or explicitly assigned Expenses" } },
        "id": { "stringUnit": { "state": "translated", "value": "Makan + Transport, atau pengeluaran yang ditetapkan langsung" } }
      }
    },
    "guideEnvelope1Row2Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Kopi + Grab" } },
        "id": { "stringUnit": { "state": "translated", "value": "Kopi + Grab" } }
      }
    },
    "guideEnvelope1Row2Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "45k on Jago + 75k on CC Danamon" } },
        "id": { "stringUnit": { "state": "translated", "value": "45 rb dari Jago + 75 rb dari CC Danamon" } }
      }
    },
    "guideEnvelope1Row3Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Remaining" } },
        "id": { "stringUnit": { "state": "translated", "value": "Tersisa" } }
      }
    },
    "guideEnvelope1Row3Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No purchases yet means 0 spent; overspending stays visible." } },
        "id": { "stringUnit": { "state": "translated", "value": "Belum ada pembelian berarti 0 terpakai; kelebihan belanja tetap terlihat." } }
      }
    },
    "guideEnvelope1Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Add or move Expenses" } },
        "id": { "stringUnit": { "state": "translated", "value": "Tambah atau pindahkan pengeluaran" } }
      }
    },
    "guideEnvelope1Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The row's + offers Add Expense or Move expenses here. Explicit assignment overrides category matching; No envelope opts out." } },
        "id": { "stringUnit": { "state": "translated", "value": "Tombol + pada baris menawarkan Tambah pengeluaran atau Pindahkan pengeluaran ke sini. Penetapan langsung mengalahkan pencocokan kategori; Tanpa pos anggaran mengecualikannya." } }
      }
    },
    "guideEnvelope1Takeaway2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keep each Expense counted once" } },
        "id": { "stringUnit": { "state": "translated", "value": "Hitung tiap pengeluaran sekali saja" } }
      }
    },
    "guideEnvelope1Takeaway2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A Category belongs to one Envelope per plan. Fixed-linked Expenses stay outside Envelopes. Earlier contributions appear in detail; overspending never blocks logging." } },
        "id": { "stringUnit": { "state": "translated", "value": "Satu kategori hanya milik satu pos anggaran per rencana. Pengeluaran yang tertaut ke Pembayaran tetap di luar pos anggaran. Kontribusi sebelumnya tampil di rincian; kelebihan belanja tidak pernah menghalangi pencatatan." } }
      }
    },
    "guideEnvelope2Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Other Accounts and cycles" } },
        "id": { "stringUnit": { "state": "translated", "value": "Sumber dana dan periode lain" } }
      }
    },
    "guideEnvelope2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keep Account and cycle separate" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pisahkan sumber dana dan periode" } }
      }
    },
    "guideEnvelope2Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Where you paid and which cycle you planned for can differ." } },
        "id": { "stringUnit": { "state": "translated", "value": "Tempat kamu membayar dan periode yang kamu rencanakan bisa berbeda." } }
      }
    },
    "guideEnvelope2Card": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Two different situations" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dua situasi berbeda" } }
      }
    },
    "guideEnvelope2Row1Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Paid elsewhere · Grab" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dibayar dari sumber lain · Grab" } }
      }
    },
    "guideEnvelope2Row1Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Harian is kept in Jago; CC Danamon paid. Record Moved from Jago after the actual move." } },
        "id": { "stringUnit": { "state": "translated", "value": "Harian disimpan di Jago; CC Danamon yang membayar. Catat Dipindahkan dari Jago setelah uangnya benar-benar dipindahkan." } }
      }
    },
    "guideEnvelope2Row2Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Paid early · Ticket" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dibayar lebih awal · Tiket" } }
      }
    },
    "guideEnvelope2Row2Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Bought in November, assigned to December's existing Liburan Envelope." } },
        "id": { "stringUnit": { "state": "translated", "value": "Dibeli di November, ditetapkan ke pos anggaran Liburan Desember yang sudah ada." } }
      }
    },
    "guideEnvelope2Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Paid elsewhere keeps Remaining" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dibayar dari sumber lain tidak mengubah Sisa" } }
      }
    },
    "guideEnvelope2Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The section appears only when both Accounts exist and differ. Choose Expenses to settle in rounds; recording a move creates no new Expense." } },
        "id": { "stringUnit": { "state": "translated", "value": "Bagian ini muncul hanya jika kedua sumber dana ada dan berbeda. Pilih pengeluaran untuk diselesaikan bertahap; mencatat pemindahan tidak membuat pengeluaran baru." } }
      }
    },
    "guideEnvelope2Takeaway2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Paid early moves the plan impact" } },
        "id": { "stringUnit": { "state": "translated", "value": "Dibayar lebih awal memindahkan dampak rencana" } }
      }
    },
    "guideEnvelope2Takeaway2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The ticket stays in November's ledger and counts in December's Envelope. November's Remaining becomes 2.7m; December contributes 700k after 300k paid early and 1m Set aside. Paid-early credit is capped; Set aside is uncapped and has no purchase." } },
        "id": { "stringUnit": { "state": "translated", "value": "Tiket tetap tercatat di November dan dihitung di pos anggaran Desember. Sisa November menjadi 2,7 jt; Desember menyumbang 700 rb setelah 300 rb dibayar lebih awal dan 1 jt disisihkan. Kredit dibayar lebih awal dibatasi; Sisihkan tanpa batas dan tanpa pembelian." } }
      }
    },
    "guideTidyTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Read and tidy Plan" } },
        "id": { "stringUnit": { "state": "translated", "value": "Baca dan rapikan Rencana" } }
      }
    },
    "guideTidySubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Sort, filter, shares and notices" } },
        "id": { "stringUnit": { "state": "translated", "value": "Urutan, filter, porsi dan pemberitahuan" } }
      }
    },
    "guideTidy1Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Views and allocation" } },
        "id": { "stringUnit": { "state": "translated", "value": "Tampilan dan alokasi" } }
      }
    },
    "guideTidy1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Read the plan your way" } },
        "id": { "stringUnit": { "state": "translated", "value": "Baca rencana dengan caramu" } }
      }
    },
    "guideTidy1Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Sorting and filtering change what you see, not what you planned." } },
        "id": { "stringUnit": { "state": "translated", "value": "Urutan dan filter mengubah yang kamu lihat, bukan yang kamu rencanakan." } }
      }
    },
    "guideTidy1Card": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose an order" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pilih urutan" } }
      }
    },
    "guideTidy1Row1Name": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Amount · Due day · Name" } },
        "id": { "stringUnit": { "state": "translated", "value": "Nominal · Jatuh tempo · Nama" } }
      }
    },
    "guideTidy1Row1Value": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Flat" } },
        "id": { "stringUnit": { "state": "translated", "value": "Rata" } }
      }
