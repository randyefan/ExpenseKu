    "aCategoryBelongsToOneEnvelopePerPlanSoTwoEnvelopes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A category belongs to one envelope per plan, so two envelopes can never count the same expense twice."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu kategori hanya bisa berada dalam satu pos anggaran per rencana, agar pengeluaran tidak dihitung dua kali."
          }
        }
      }
    },
    "aGroupAnswersWhatMoneyIsForAboveTheCategoryThat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group answers what money is for, above the category that says what it bought. Only a plan's share-of-income table reads them."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup mengelompokkan tujuan dana, sedangkan kategori menjelaskan jenis pembeliannya. Grup hanya digunakan dalam tabel alokasi pemasukan pada rencana."
          }
        }
      }
    },
