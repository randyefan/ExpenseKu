      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Funded points to unpaid Fixed items; payday points to the transfer checklist." } },
        "id": { "stringUnit": { "state": "translated", "value": "Dana siap menunjuk Pembayaran yang belum lunas; gajian menunjuk daftar transfer." } }
      }
    },
    "guideTidy2Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your view can reset" } },
        "id": { "stringUnit": { "state": "translated", "value": "Tampilanmu bisa kembali semula" } }
      }
    },
    "guideTidy2Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Sort returns to Amount on cycle paging or relaunch. Switching lens keeps it." } },
        "id": { "stringUnit": { "state": "translated", "value": "Urutan kembali ke Nominal saat berpindah periode atau membuka ulang aplikasi. Berganti tampilan tetap mempertahankannya." } }
      }
    },
    "guideTidy2Takeaway2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Clear only an upcoming plan" } },
        "id": { "stringUnit": { "state": "translated", "value": "Hapus hanya rencana mendatang" } }
      }
    },
    "guideTidy2Takeaway2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use Plan options → Clear Plan. The confirmation names links that lose their place; Expenses are kept. Current and past plans cannot be cleared. Guide progress stays." } },
        "id": { "stringUnit": { "state": "translated", "value": "Gunakan Opsi rencana → Hapus rencana. Konfirmasinya menyebut tautan yang akan hilang; pengeluaran tetap disimpan. Rencana saat ini dan sebelumnya tidak bisa dihapus. Kemajuan panduan tetap tersimpan." } }
      }
    }
  },
  "version": "1.1"
