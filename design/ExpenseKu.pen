                    {
                      "type": "text",
                      "id": "kcfIU",
                      "name": "Note",
                      "fill": "$color/text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Every row starts with the Account's wordmark chip in a fixed 60pt column, so the banks line up down the list and can be scanned like a bank statement's column. The category icon becomes a small tinted glyph before the bold category name; meta and plan tags as today; the trailing side is the amount alone. The chip is 22pt tall with the cropped wordmark, so the letters are ~3x today's. Cash and brandless Accounts show their symbol in the same column. Reference: bank statements, YNAB's account column, Copilot's account chip.",
                      "lineHeight": 1.45,
                      "fontFamily": "$font/family",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
