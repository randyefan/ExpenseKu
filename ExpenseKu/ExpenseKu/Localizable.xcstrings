    "anEnvelopeNeverCreatesAnExpenseSoItHasNoDue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An envelope never creates an expense, so it has no due day and no Auto. Its Categories are optional: with none, it fills only from expenses you assign to it. Its Account is optional too: set it and the allowance joins that account's transfer line and can be marked as moved."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pos anggaran tidak mencatat pengeluaran, sehingga tidak memiliki tanggal jatuh tempo atau pencatatan otomatis. Kategori opsional: jika kosong, hanya pengeluaran yang kamu masukkan yang dihitung. Sumber dana juga opsional: jika dipilih, anggarannya masuk ke daftar transfer dan bisa ditandai sudah dipindahkan."
          }
        }
      }
    },
