      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Prepare some or all" } },
        "id": { "stringUnit": { "state": "translated", "value": "Siapkan sebagian atau semuanya" } }
      }
    },
    "guideIntro2Takeaway2Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "You can fund Harian now and leave the Liburan set-aside for later. ExpenseKu records your report; it never transfers money." } },
        "id": { "stringUnit": { "state": "translated", "value": "Kamu bisa menyiapkan Harian sekarang dan menunda dana sisihan Liburan. ExpenseKu mencatat laporanmu; aplikasi ini tidak pernah mentransfer uang." } }
      }
