    "setAsideSendsPlannedMoneyToAnEnvelopeInALater": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set aside sends planned money to an envelope in a later plan. It never creates an expense: this plan's remaining funds decrease and that plan's increase. Its Account is optional: set it and the amount joins that account's transfer line and can be marked as moved."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisihkan dana ke pos anggaran pada rencana berikutnya. Ini tidak mencatat pengeluaran: sisa dana rencana ini berkurang dan rencana tujuan bertambah. Sumber dana opsional: jika dipilih, nominal masuk ke daftar transfer dan bisa ditandai sudah dipindahkan."
          }
        }
      }
    },
