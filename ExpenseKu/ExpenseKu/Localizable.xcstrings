    "guideIntro2Takeaway1Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Move money in your banking app" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pindahkan uang di aplikasi bankmu" } }
      }
    },
    "guideIntro2Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Then open an Account here, select the items you moved, and record Moved to that Account." } },
        "id": { "stringUnit": { "state": "translated", "value": "Lalu buka sumber dana di sini, pilih item yang sudah dipindahkan, dan catat Dipindahkan ke sumber dana itu." } }
