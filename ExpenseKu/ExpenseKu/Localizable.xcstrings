    "guideIntro1Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use Fixed for one payment, Envelope for many purchases, and Set aside for a later envelope." } },
        "id": { "stringUnit": { "state": "translated", "value": "Gunakan Pembayaran untuk satu tagihan, Pos anggaran untuk banyak pembelian, dan Sisihkan untuk pos anggaran di periode berikutnya." } }
      }
    },
    "guideIntro2Step": {
      "extractionState": "manual",
      "localizations": {
