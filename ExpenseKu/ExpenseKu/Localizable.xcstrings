    "guideTidy1Takeaway1Body": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Tap the Funded notice for unpaid Fixed items. Totals stay; Amount order is forced and the sort control hides. Group shares measure planned income allocation, not actual spending." } },
        "id": { "stringUnit": { "state": "translated", "value": "Ketuk pemberitahuan Dana siap untuk Pembayaran yang belum lunas. Total tetap; urutan Nominal dipaksakan dan kontrol urutan disembunyikan. Porsi grup mengukur alokasi pemasukan terencana, bukan pengeluaran nyata." } }
      }
    },
    "guideTidy2Step": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Notices and clearing" } },
        "id": { "stringUnit": { "state": "translated", "value": "Pemberitahuan dan penghapusan" } }
      }
    },
    "guideTidy2Heading": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Review first, clear with care" } },
        "id": { "stringUnit": { "state": "translated", "value": "Periksa dulu, hapus dengan hati-hati" } }
      }
    },
    "guideTidy2Lead": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Notices surface one task at a time. Clearing is reserved for a future plan." } },
        "id": { "stringUnit": { "state": "translated", "value": "Pemberitahuan menampilkan satu tugas sekaligus. Penghapusan hanya untuk rencana mendatang." } }
      }
    },
